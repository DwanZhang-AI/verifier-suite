{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerifierPackage index (package.json)",
  "description": "Top-level index of a verifier package. Parts absent from the generation mode are listed as false — a monolithic generation ships checks+provenance only and never fabricates a post-hoc contract.",
  "type": "object",
  "required": ["schema_version", "dataset", "task_id", "parts"],
  "properties": {
    "schema_version": {"type": "string"},
    "dataset": {"type": "string"},
    "task_id": {"type": "string"},
    "parts": {
      "type": "object",
      "required": ["checks", "provenance", "aggregation"],
      "properties": {
        "checks": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "provenance": {"const": true},
        "aggregation": {"const": true},
        "contract": {"type": "boolean"},
        "env_map": {"type": "boolean"},
        "evidence_manifest": {"type": "boolean"},
        "rubric": {"type": "boolean"}
      }
    }
  }
}
